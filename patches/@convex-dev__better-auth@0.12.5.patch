+describe("convexBetterAuthNextJs getToken", () => {
+  afterEach(() => {
+    vi.restoreAllMocks();
+    getRequestHeaders.mockReset();
+  });
+
+  it("tunnels the public origin without exposing it to Convex ingress", async () => {
+    const cookie = "better-auth.session_token=session-cookie";
