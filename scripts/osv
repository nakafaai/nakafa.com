#!/usr/bin/env bash

set -euo pipefail

readonly osv_version="2.6.0"

case "$(uname -s):$(uname -m)" in
  Darwin:arm64)
    readonly osv_asset="osv-scanner_darwin_arm64"
    readonly osv_checksum="98c460dcd37de25819babd757d04542045b6243113e209edcd4d89fedb0256b4"
    ;;
  Darwin:x86_64)
    readonly osv_asset="osv-scanner_darwin_amd64"
    readonly osv_checksum="60c5296637e977b28eeda5c7f13573e447659a632922737f94d11fa7e30ad6ca"
    ;;
  Linux:aarch64)
    readonly osv_asset="osv-scanner_linux_arm64"
    readonly osv_checksum="2c71403eb443d05891c4f268c3ad771cf4f16e5443463fd7851ef8f454d3c7e4"
    ;;
  Linux:x86_64)
    readonly osv_asset="osv-scanner_linux_amd64"
    readonly osv_checksum="ca69b3d3cd08f889a49dc0a383122f71cc528b83803671df5fd874d97485b108"
    ;;
  *)
    echo "OSV Scanner does not publish a binary for this platform." >&2
    exit 1
    ;;
esac

# A network outage must not fail the audit before it has lasted this long, and
# the audit fails clearly once it has.
readonly patience_seconds=180

# The verified binary is cached per version, so most runs never download it.
# The checksum is checked on every run, so a changed cache entry never runs.
readonly osv_cache="${XDG_CACHE_HOME:-${HOME}/.cache}/osv-scanner/${osv_version}"
readonly osv_binary="${osv_cache}/${osv_asset}"

checksum_of() {
  openssl dgst -sha256 "$1" | awk '{print $2}'
}

# GitHub throttles anonymous release downloads under load (every download
# answered 504 on 9 Nov 2026), so a job that has a token downloads as itself.
# The header comes from a file descriptor, never the command line, and curl
# sends it to github.com alone, not to the asset host the download redirects to.
# curl doubles its wait after each failed try, from one second, until the
# retries end or the patience runs out.
download_osv() {
  curl \
    --connect-timeout 10 \
    --fail \
    --location \
    --max-filesize 134217728 \
    --max-time 120 \
    --output "${osv_download}" \
    --proto '=https' \
    --retry 10 \
    --retry-all-errors \
    --retry-max-time "${patience_seconds}" \
    --show-error \
    --silent \
    --tlsv1.2 \
    "$@" \
    "https://github.com/google/osv-scanner/releases/download/v${osv_version}/${osv_asset}"
}

if [[ -f "${osv_binary}" && "$(checksum_of "${osv_binary}")" != "${osv_checksum}" ]]; then
  echo "The cached OSV Scanner does not match its checksum, so it is downloaded again." >&2
  rm -f -- "${osv_binary}"
fi

if [[ ! -f "${osv_binary}" ]]; then
  mkdir -p -- "${osv_cache}"
  osv_download="$(mktemp "${osv_cache}/download.XXXXXX")"
  trap 'rm -f -- "${osv_download}"' EXIT
  downloaded=0
  if [[ -n "${GITHUB_TOKEN:-}" ]]; then
    download_osv --header @<(printf 'Authorization: Bearer %s\n' "${GITHUB_TOKEN}") || downloaded=$?
  else
    download_osv || downloaded=$?
  fi
  if (( downloaded != 0 )); then
    echo "OSV Scanner ${osv_version} could not be downloaded within ${patience_seconds} seconds, so the audit fails." >&2
    exit 1
  fi
  if [[ "$(checksum_of "${osv_download}")" != "${osv_checksum}" ]]; then
    echo "OSV Scanner checksum verification failed." >&2
    exit 1
  fi
  chmod 700 "${osv_download}"
  mv -- "${osv_download}" "${osv_binary}"
fi

# Every argument names one more lockfile, scanned after the Bun lockfile.
lockfile_arguments=("--lockfile=bun.lock")
for lockfile in "$@"; do
  lockfile_arguments+=("--lockfile=${lockfile}")
done

# OSV Scanner exits with 127 for a general error, such as an OSV API outage,
# and with 1 when it finds a vulnerability, which is never retried.
readonly general_error=127
started="${SECONDS}"
wait_seconds=5
while true; do
  status=0
  "${osv_binary}" scan source \
    --config=osv.toml \
    "${lockfile_arguments[@]}" || status=$?
  if (( status != general_error )); then
    exit "${status}"
  fi
  if (( SECONDS - started + wait_seconds > patience_seconds )); then
    echo "OSV Scanner failed with a general error on every try within ${patience_seconds} seconds, so the audit fails." >&2
    exit "${status}"
  fi
  echo "OSV Scanner failed with a general error, so it scans again in ${wait_seconds} seconds." >&2
  sleep "${wait_seconds}"
  wait_seconds=$(( wait_seconds * 2 ))
done
