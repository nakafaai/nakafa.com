#!/usr/bin/env bash

set -euo pipefail
umask 077

readonly PROJECT_ID="prj_QfxvXBST46wuSTOXPn4PE32NqbF4"
script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
readonly script_root
repository_root="$(cd "$script_root/../.." && pwd -P)"
readonly repository_root
readonly backend_root="$repository_root/packages/backend"
readonly www_root="$repository_root/apps/www"

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

if [[ "${VERCEL:-}" != "1" || \
  "${VERCEL_ENV:-}" != "production" || \
  "${VERCEL_TARGET_ENV:-}" != "production" || \
  "${VERCEL_PROJECT_ID:-}" != "$PROJECT_ID" || \
  "${VERCEL_GIT_PROVIDER:-}" != "github" || \
  "${VERCEL_GIT_REPO_OWNER:-}" != "nakafaai" || \
  "${VERCEL_GIT_REPO_SLUG:-}" != "nakafa.com" || \
  "${VERCEL_GIT_COMMIT_REF:-}" != "main" ]]; then
  fail "The snapshot build requires the protected Vercel production identity."
fi
if [[ ! "${VERCEL_DEPLOYMENT_ID:-}" =~ ^dpl_[A-Za-z0-9]+$ || \
  ! "${VERCEL_GIT_COMMIT_SHA:-}" =~ ^[0-9a-f]{40}$ ]]; then
  fail "The snapshot build requires exact Vercel deployment and commit identities."
fi
if [[ -z "${NEXT_PUBLIC_CONVEX_URL:-}" || \
  -z "${VITE_CONVEX_SITE_URL:-}" ]]; then
  fail "The production Convex command did not provide its public URLs."
fi
if [[ -e "$backend_root/.env.local" || -L "$backend_root/.env.local" || \
  -e "$backend_root/.convex" || -L "$backend_root/.convex" ]]; then
  fail "The Vercel checkout already contains Convex local state."
fi

readonly temp_parent="${TMPDIR:-/tmp}"
runtime_root="$(mktemp -d "$temp_parent/nakafa-runtime.XXXXXX")"
chmod 700 "$runtime_root"
export RUNNER_TEMP="$runtime_root"

convex_pid=""

stop_local_backend() {
  if [[ ! "$convex_pid" =~ ^[0-9]+$ ]]; then
    return
  fi

  kill -- "-$convex_pid" 2>/dev/null || true
  for _attempt in {1..20}; do
    if ! kill -0 -- "-$convex_pid" 2>/dev/null; then
      return
    fi
    sleep 0.25
  done
  kill -KILL -- "-$convex_pid" 2>/dev/null || true
}

cleanup() {
  local exit_code="$?"
  set +e
  stop_local_backend

  rm -rf -- "$backend_root/.convex"
  rm -f -- "$backend_root/.env.local"
  case "$runtime_root" in
    "$temp_parent"/nakafa-runtime.*)
      rm -rf -- "$runtime_root"
      ;;
  esac
  trap - EXIT
  exit "$exit_code"
}
trap cleanup EXIT

load_fingerprint() {
  local output="$RUNNER_TEMP/runtime-schema.env"
  rm -f -- "$output"
  pnpm --silent --dir "$backend_root" runtime:ci fingerprint

  if [[ ! -f "$output" || -L "$output" || \
    "$(stat -c '%a' "$output")" != "600" || \
    "$(wc -l < "$output")" -ne 1 ]] || \
    ! grep -Exq 'CONTENT_RUNTIME_SCHEMA_HASH=[a-f0-9]{64}' "$output"; then
    fail "Invalid signed runtime fingerprint output."
  fi
  export "$(< "$output")"
  rm -f -- "$output"
}

load_selection() {
  local output="$RUNNER_TEMP/runtime-state.env"
  rm -f -- "$output"
  pnpm --silent --dir "$backend_root" runtime:ci generations

  if [[ ! -f "$output" || -L "$output" || \
    "$(stat -c '%a' "$output")" != "600" || \
    "$(wc -l < "$output")" -ne 1 ]] || \
    ! grep -Exq 'CONTENT_RUNTIME_SELECTION_HASH=[a-f0-9]{64}' "$output"; then
    fail "Invalid production runtime selection output."
  fi
  CONTENT_RUNTIME_SELECTION_HASH="$(
    sed -n 's/^CONTENT_RUNTIME_SELECTION_HASH=//p' "$output"
  )"
  export CONTENT_RUNTIME_SELECTION_HASH
  rm -f -- "$output"
}

download_snapshot() {
  local asset="snapshot.${CONTENT_RUNTIME_SELECTION_HASH}.${CONTENT_RUNTIME_SCHEMA_HASH}.gpg"
  local directory="$RUNNER_TEMP/runtime-cache"
  local target="$directory/runtime.tar.gpg"
  local download="$target.download"
  mkdir -m 700 "$directory"

  for _attempt in {1..180}; do
    rm -f -- "$download"
    if curl --fail --location --silent \
      "https://github.com/nakafaai/nakafa.com/releases/download/runtime/$asset" \
      --output "$download" && [[ -s "$download" && ! -L "$download" ]]; then
      chmod 600 "$download"
      mv -- "$download" "$target"
      return
    fi
    sleep 5
  done

  fail "The exact signed runtime snapshot is unavailable."
}

load_fingerprint
load_selection
pnpm --silent --dir "$backend_root" runtime:ci verify-generations
download_snapshot
export CONTENT_RUNTIME_TOKEN="build-local-runtime"

env -u CONVEX_DEPLOY_KEY -u CONVEX_DEPLOYMENT_TOKEN \
  CONVEX_AGENT_MODE=anonymous \
  pnpm --dir "$backend_root" exec convex init

local_url="$(sed -n 's/^VITE_CONVEX_URL=//p' "$backend_root/.env.local")"
readonly local_url
local_site="$(sed -n 's/^VITE_CONVEX_SITE_URL=//p' "$backend_root/.env.local")"
readonly local_site
case "$local_url" in
  http://127.0.0.1:*) ;;
  *) fail "Anonymous Convex client URL is not local." ;;
esac
case "$local_site" in
  http://127.0.0.1:*) ;;
  *) fail "Anonymous Convex site URL is not local." ;;
esac

env -u CONVEX_DEPLOY_KEY -u CONVEX_DEPLOYMENT_TOKEN \
  CONVEX_AGENT_MODE=anonymous \
  pnpm --dir "$backend_root" exec convex env set --force <<EOF
AI_GATEWAY_API_KEY=build-disabled
AKSARA_PUBLICATION_TOKEN=build-disabled
AUTH_GOOGLE_ID=build-disabled
AUTH_GOOGLE_SECRET=build-disabled
BETTER_AUTH_SECRET=build-inert-secret-00000000
CONTENT_RUNTIME_TOKEN=$CONTENT_RUNTIME_TOKEN
FIRECRAWL_API_KEY=build-disabled
JWKS=[]
NAKAFA_API_EDGE_SECRET=build-api-edge-secret
NAKAFA_MCP_ALLOWED_ORIGINS=https://nakafa.com
NAKAFA_MCP_EDGE_SECRET=build-mcp-edge-secret
NEXT_PUBLIC_POLAR_SERVER=sandbox
OPENWEATHER_API_KEY=build-disabled
POLAR_ACCESS_TOKEN=build-disabled
POLAR_WEBHOOK_SECRET=build-disabled
POSTHOG_ERASURE_API_KEY=build-disabled
POSTHOG_HOST=https://example.invalid
POSTHOG_PROJECT_ID=0
POSTHOG_PROJECT_TOKEN=build-disabled
RESEND_API_KEY=build-disabled
RESEND_WEBHOOK_SECRET=build-disabled
SITE_URL=https://nakafa.com
EOF

env -u CONVEX_DEPLOY_KEY -u CONVEX_DEPLOYMENT_TOKEN \
  CONVEX_AGENT_MODE=anonymous \
  pnpm --dir "$backend_root" exec convex dev \
  --once \
  --typecheck enable \
  --tail-logs disable

readonly convex_log="$RUNNER_TEMP/convex.log"
: > "$convex_log"
chmod 600 "$convex_log"
setsid env -u CONVEX_DEPLOY_KEY -u CONVEX_DEPLOYMENT_TOKEN \
  CONVEX_AGENT_MODE=anonymous \
  pnpm --dir "$backend_root" exec convex dev \
  --codegen disable \
  --typecheck disable \
  --tail-logs always > "$convex_log" 2>&1 &
convex_pid="$!"

for _attempt in {1..120}; do
  if ! kill -0 "$convex_pid" 2>/dev/null; then
    fail "The anonymous local backend exited before becoming ready."
  fi
  if grep -Fq 'Convex functions ready!' "$convex_log" && \
    curl -fsS "$local_url/instance_name" >/dev/null; then
    break
  fi
  if [[ "$_attempt" == "120" ]]; then
    fail "The anonymous local backend did not become ready."
  fi
  sleep 2
done

env -u CONVEX_DEPLOY_KEY -u CONVEX_DEPLOYMENT_TOKEN \
  CONVEX_AGENT_MODE=anonymous \
  pnpm --silent --dir "$backend_root" runtime:ci import

env -u CONVEX_DEPLOY_KEY -u CONVEX_DEPLOYMENT_TOKEN \
  NEXT_PUBLIC_CONVEX_SITE_URL="$local_site" \
  NEXT_PUBLIC_CONVEX_URL="$local_url" \
  pnpm --filter www verify:featured-renderer

export CONTENT_BUILD_SITE_URL="$local_site"
export CONTENT_BUILD_URL="$local_url"
export NEXT_PUBLIC_CONVEX_SITE_URL="$VITE_CONVEX_SITE_URL"

env -u CONVEX_DEPLOY_KEY -u CONVEX_DEPLOYMENT_TOKEN \
  pnpm --dir "$www_root" typecheck
env -u CONVEX_DEPLOY_KEY -u CONVEX_DEPLOYMENT_TOKEN \
  TURBO_CONCURRENCY=2 pnpm --dir "$www_root" build
pnpm --silent --dir "$backend_root" runtime:ci verify-generations
