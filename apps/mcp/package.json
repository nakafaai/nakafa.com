{
  "name": "mcp",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "build": "next build --turbopack",
    "build:vercel": "pnpm --dir ../../packages/backend typecheck && pnpm --dir ../../packages/backend exec convex deploy --yes --typecheck disable --typecheck-components --cmd 'pnpm --dir ../../apps/mcp typecheck' --cmd-url-env-var-name NAKAFA_CONVEX_URL",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "next dev -p 3001 --turbopack",
    "start": "next start -p 3001",
    "test": "NODE_ENV=test vitest run",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "test:ui": "NODE_ENV=test vitest --ui",
    "test:watch": "NODE_ENV=test vitest watch",
    "typecheck": "next typegen && tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@repo/backend": "workspace:*",
    "@repo/next-config": "workspace:*",
    "effect": "catalog:",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@repo/testing": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "19.2.18",
    "@vercel/config": "^0.6.1",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
