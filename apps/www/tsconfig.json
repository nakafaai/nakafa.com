{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "@repo/internationalization/i18n.d.ts",
      "vitest/globals"
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@repo/*": ["../../packages/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "scripts/**/*.mts", "*.mts"],
  "exclude": ["node_modules", ".output", ".vercel", "out", "dist", "build"]
}
