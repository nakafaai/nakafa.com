{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "@repo/internationalization/i18n.d.ts",
      "vitest/globals"
    ],
    "paths": {
      "@/e2e/*": ["./e2e/*"],
      "@/checks/*": ["./checks/*"],
      "@/scripts/*": ["./scripts/*"],
      "@/public/*": ["./public/*"],
      "@/*": ["./src/*"],
      "@repo/*": ["../../packages/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "scripts/**/*.mts", "*.mts"],
  "exclude": ["node_modules", ".output", "out", "dist", "build"]
}
