{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "@repo/internationalization/i18n.d.ts",
      "vitest/globals"
    ],
    "paths": {
      "@/*": ["./*"],
      "@repo/*": ["../../packages/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "scripts/**/*.mts",
    "*.mts"
  ],
  "exclude": ["node_modules", ".output", ".vercel", "out", "dist", "build"]
}
