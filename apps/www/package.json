{
  "name": "www",
  "version": "2.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "next experimental-analyze",
    "build": "next build",
    "build:vercel": "pnpm --dir ../../packages/backend typecheck && pnpm --dir ../../packages/backend exec convex deploy --yes --typecheck disable --typecheck-components --cmd 'pnpm --dir ../.. run build --filter=www' --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "portless run --name nakafa next dev",
    "doctor": "pnpm dlx react-doctor@0.9.12",
    "google-index": "node --env-file=.env.local --import tsx scripts/google-index.ts",
    "index-now": "node --env-file=.env.local --import tsx scripts/index-now.ts",
    "start": "portless run --name nakafa next start",
    "test": "NODE_OPTIONS='--no-experimental-webstorage' vitest run",
    "test:browser": "playwright test",
    "test:coverage": "NODE_OPTIONS='--no-experimental-webstorage' vitest run --coverage",
    "test:ui": "NODE_OPTIONS='--no-experimental-webstorage' vitest --ui",
    "test:watch": "NODE_OPTIONS='--no-experimental-webstorage' vitest watch",
    "typecheck": "next typegen && tsc --noEmit --emitDeclarationOnly false",
    "verify:featured-renderer": "tsx --conditions=import --conditions=react-server e2e/featured/renderer.mts"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.80",
    "@convex-dev/better-auth": "0.12.5",
