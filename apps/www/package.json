{
  "name": "www",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "next experimental-analyze",
    "build": "pnpm verify:featured-renderer && tsx scripts/build/main.ts next build --experimental-build-mode compile && tsx scripts/build/main.ts next build --experimental-build-mode generate",
    "build:vercel": "pnpm --dir ../../packages/backend run deploy --yes --typecheck enable && pnpm --dir ../.. run build --filter=www",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "portless run --name nakafa next dev",
    "doctor": "pnpm --config.minimum-release-age=1440 dlx react-doctor@0.9.17",
    "google-index": "node --env-file=.env.local --import tsx scripts/google-index.ts",
    "index-now": "node --env-file=.env.local --import tsx scripts/index-now.ts",
    "renderer:manifest": "tsx --conditions=import --conditions=react-server scripts/content/renderer.ts",
    "start": "portless run --name nakafa next start",
    "test": "NODE_OPTIONS='--no-experimental-webstorage' vitest run",
    "test:browser": "playwright test",
    "test:ui": "NODE_OPTIONS='--no-experimental-webstorage' vitest --ui",
    "test:watch": "NODE_OPTIONS='--no-experimental-webstorage' vitest watch",
    "typecheck": "next typegen && tsc --checkers 2 --noEmit --emitDeclarationOnly false",
    "verify:featured-renderer": "node --env-file-if-exists=.env.local --import tsx --conditions=import --conditions=react-server scripts/content/featured.mts"
  },
  "dependencies": {
    "@confect/core": "catalog:",
    "@confect/js": "10.1.0",
    "@confect/react": "10.1.0",
    "@convex-dev/agent": "catalog:",
    "@convex-dev/better-auth": "0.12.5",
    "@hugeicons/core-free-icons": "catalog:",
    "@hugeicons/react": "catalog:",
    "@mantine/hooks": "catalog:",
    "@mdx-js/mdx": "3.1.1",
    "@nakafa/aksara-contracts": "0.48.5",
    "@paper-design/shaders-react": "^0.0.81",
    "@repo/analytics": "workspace:*",
    "@repo/backend": "workspace:*",
    "@repo/contents": "workspace:*",
    "@repo/design-system": "workspace:*",
    "@repo/internationalization": "workspace:*",
    "@repo/math": "workspace:*",
    "@repo/next-config": "workspace:*",
    "@repo/seo": "workspace:*",
    "@repo/utilities": "workspace:*",
    "@shadcn/react": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/react-form": "^1.33.5",
    "@vercel/functions": "^3.9.11",
    "ai": "catalog:",
    "any-ascii": "^0.3.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "better-auth": "1.6.33",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "convex": "1.46.0",
    "country-flag-icons": "^1.6.20",
    "date-fns": "4.4.0",
    "effect": "catalog:",
    "feed": "^6.0.0",
    "motion": "catalog:",
    "nanoid": "^6.0.2",
    "next": "16.4.0",
    "next-intl": "catalog:",
    "next-themes": "catalog:",
    "nuqs": "^2.10.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "catalog:",
