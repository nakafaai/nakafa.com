{
  "name": "email",
  "version": "0.0.3",
  "private": true,
  "scripts": {
    "build": "email export --outDir dist --dir ../../packages/email/templates",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "portless run --name email.nakafa sh -c 'email dev --port \"${PORT:-3004}\" --dir ../../packages/email/templates'",
    "export": "email export --dir ../../packages/email/templates",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-email": "catalog:"
  },
  "devDependencies": {
    "@react-email/ui": "6.11.1",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "19.3.0"
  }
}
