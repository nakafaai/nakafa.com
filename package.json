{
  "name": "nakafa",
  "version": "1.0.2",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "imports": {
    "#scripts/*": "./scripts/*.ts"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@alchemy.run/cloudflare": "2.0.0-beta.84",
      "@alchemy.run/cloudflare-runtime": "2.0.0-beta.84",
      "@alchemy.run/github": "2.0.0-beta.84",
      "@confect/core": "10.4.1",
      "@convex-dev/agent": "0.7.8",
      "@convex-dev/ai-sdk-provider": "0.3.0",
      "@effect/platform-browser": "4.1.0",
      "@effect/platform-bun": "4.1.0",
      "@effect/platform-node": "4.1.0",
      "@effect/vitest": "4.1.0",
      "@hugeicons/core-free-icons": "^4.3.5",
      "@hugeicons/react": "^1.1.10",
      "@mantine/hooks": "^9.7.3",
      "@react-email/render": "2.2.0",
      "@shadcn/react": "0.3.1",
      "@vitest/coverage-istanbul": "5.0.5",
      "@vitest/ui": "5.0.5",
      "ai": "7.0.140",
      "alchemy": "2.0.0-beta.84",
      "class-variance-authority": "^0.7.1",
      "cn": "0.5.0",
      "effect": "4.1.0",
      "motion": "^14.6.0",
      "react-email": "6.11.5",
      "remark-mdx": "3.1.1",
      "remark-parse": "11.0.0",
      "sonner": "^2.0.8",
      "typescript": "7.0.2",
      "unified": "11.0.5",
      "use-intl": "4.14.9",
      "virtua": "^0.54.0",
      "vite": "^8.3.5",
      "vitest": "5.0.5",
      "zustand": "^5.0.16"
    }
  },
  "scripts": {
    "acceptance:build": "bun --filter @repo/backend codegen && bun run --cwd packages/backend acceptance build",
    "acceptance:clean": "bun run --cwd packages/backend acceptance clean",
    "acceptance:prepare": "bun --filter @repo/backend codegen && bun run --cwd packages/backend acceptance prepare",
    "acceptance:start": "bun --filter @repo/backend codegen && bun run --cwd packages/backend acceptance start",
    "analyze": "turbo run analyze",
    "boundaries": "turbo boundaries",
    "build": "bun run check && turbo run build",
    "bump-deps": "node scripts/dependencies/bump.ts && turbo run bump-deps --filter=cas",
    "bump-ui": "bunx --minimum-release-age 86400 shadcn@latest add --all --overwrite -c packages/design-system",
    "changeset": "changeset",
    "check": "bun run check:patches && bun run check:tests",
    "check:patches": "node scripts/check/patches.ts",
    "check:site": "bunx --no-install --cwd apps/www vitest run --config vitest.afdocs.mts --coverage.enabled=false",
    "check:tests": "node scripts/check/tests.ts",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules .cache apps/*/.cache packages/*/.cache apps/*/.turbo packages/*/.turbo apps/*/.ruff_cache apps/*/.pytest_cache apps/*/.venv apps/*/.coverage .turbo .next apps/*/.next apps/*/.react-email packages/*/.react-email coverage apps/*/coverage packages/*/coverage && find apps packages -name __pycache__ -type d -prune -exec rm -rf {} +",
    "dev": "turbo run dev --filter=www --filter=@repo/backend --filter=cas",
    "dev:all": "turbo run dev",
    "dev:web": "turbo run dev --filter=www --filter=@repo/backend --filter=cas",
    "doctor": "bun --filter www doctor",
    "effect:source:check": "node scripts/effect/source.ts check",
    "effect:source:update": "node scripts/effect/source.ts update",
    "format": "ultracite fix && turbo run format --filter=cas",
    "format:doctor": "ultracite doctor",
    "lint": "bun run effect:source:check && bun run check && ultracite check && turbo run lint --filter=cas",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "security:audit": "bash scripts/osv apps/cas/uv.lock",
    "start": "turbo run start",
    "test": "bun run check && bun run test:scripts && turbo run test",
    "test:scripts": "bun run typecheck:scripts && vitest run --config scripts/vitest.config.mts",
    "test:ui": "turbo run test:ui",
    "test:watch": "turbo run test:watch",
    "typecheck:scripts": "tsc --project scripts/tsconfig.json --noEmit",
    "version-packages": "changeset version"
  },
  "overrides": {
    "@ai-sdk/provider-utils@5>undici": "7.30.1",
    "@effect/ai-openai-compat": "4.1.0",
    "@effect/ai-openrouter": "4.1.0",
    "@effect/platform-node": "4.1.0",
    "@effect/platform-node-shared": "4.1.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth@1.6.33>@babel/core": "7.29.7",
    "axios": "1.20.0",
    "convex-helpers": "0.1.131",
    "dompurify": "^3.4.17",
    "fast-uri": "3.1.9",
    "ip-address": "10.7.4",
    "lodash": "4.18.1",
    "mermaid@11.17.2>katex": "0.19.1",
    "micromark-extension-math@3.1.0>katex": "0.19.1",
    "prosemirror-transform": "1.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "seroval": "1.7.3",
    "seroval-plugins": "1.7.3",
    "source-map-js": "1.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "0.63.0",
    "@effect/vitest": "catalog:",
    "@repo/testing": "workspace:*",
    "@repo/utilities": "workspace:*",
    "@sigstore/bundle": "5.0.0",
    "@turbo/gen": "2.11.10",
    "@types/node": "24.19.2",
    "effect": "catalog:",
    "esbuild": "0.28.2",
    "portless": "0.15.12",
    "sigstore": "5.0.0",
    "turbo": "2.11.10",
    "typescript": "catalog:",
    "ultracite": "8.0.2",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "download"
    }
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "core-js",
    "core-js-pure",
    "esbuild",
    "msgpackr-extract",
    "msw",
    "protobufjs",
    "sharp",
    "workerd"
  ]
}
