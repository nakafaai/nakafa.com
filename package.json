{
  "name": "nakafa",
  "version": "1.0.2",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "imports": {
    "#scripts/*": "./scripts/*.ts"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@alchemy.run/cloudflare": "2.0.0-beta.87",
      "@alchemy.run/cloudflare-runtime": "2.0.0-beta.87",
      "@alchemy.run/github": "2.0.0-beta.87",
      "@confect/core": "10.6.0",
      "@convex-dev/agent": "0.7.11",
      "@convex-dev/ai-sdk-provider": "0.3.0",
      "@effect/platform-bun": "4.1.5",
      "@effect/platform-node": "4.1.5",
      "@effect/vitest": "4.1.5",
      "@hugeicons/core-free-icons": "^4.3.5",
      "@hugeicons/react": "^1.1.10",
      "@mantine/hooks": "^9.8.0",
      "@react-email/render": "2.3.1",
      "@shadcn/react": "0.3.1",
      "@tanstack/react-router": "1.170.46",
      "@tanstack/react-start": "1.169.7",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitest/coverage-istanbul": "5.1.1",
      "@vitest/ui": "5.1.1",
      "ai": "7.0.179",
      "alchemy": "2.0.0-beta.87",
      "class-variance-authority": "^0.7.1",
      "cn": "0.5.2",
      "convex": "1.51.0",
      "effect": "4.1.5",
      "motion": "14.14.0",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "react-email": "6.11.16",
      "remark-mdx": "3.1.1",
      "remark-parse": "11.0.0",
      "tsrs": "7.1.0-beta.tsrs3",
      "unified": "11.0.5",
      "use-intl": "4.15.1",
      "virtua": "^0.55.0",
      "vite": "^8.3.8",
      "vitest": "5.1.1",
      "zustand": "^5.1.0"
    }
  },
  "scripts": {
    "acceptance:build": "bun --filter @repo/backend codegen && bun run --cwd packages/backend acceptance build",
    "acceptance:clean": "bun run --cwd packages/backend acceptance clean",
    "acceptance:prepare": "bun --filter @repo/backend codegen && bun run --cwd packages/backend acceptance prepare",
    "acceptance:start": "bun --filter @repo/backend codegen && bun run --cwd packages/backend acceptance start",
    "analyze": "turbo run analyze",
    "boundaries": "turbo boundaries",
    "build": "bun run check && turbo run build",
    "bump-deps": "node scripts/dependencies/bump.ts && turbo run bump-deps --filter=cas",
    "changeset": "changeset",
    "check": "bun run check:patches && bun run check:tests",
    "check:patches": "node scripts/check/patches.ts",
    "check:site": "bunx --no-install --cwd apps/www vitest run --config afdocs.config.mts --coverage.enabled=false",
    "check:tests": "node scripts/check/tests.ts",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules .cache apps/*/.cache packages/*/.cache apps/*/.turbo packages/*/.turbo apps/*/.ruff_cache apps/*/.pytest_cache apps/*/.venv apps/*/.coverage .turbo .next apps/*/.next apps/*/.react-email packages/*/.react-email coverage apps/*/coverage packages/*/coverage && find apps packages -name __pycache__ -type d -prune -exec rm -rf {} +",
    "dev": "turbo run dev --filter=www --filter=@repo/backend --filter=cas",
    "dev:all": "turbo run dev",
    "dev:web": "turbo run dev --filter=www --filter=@repo/backend --filter=cas",
    "doctor": "bun --filter www doctor",
    "effect:source:check": "node scripts/effect/source.ts check",
    "effect:source:update": "node scripts/effect/source.ts update",
    "format": "ultracite fix && turbo run format --filter=cas",
    "format:doctor": "ultracite doctor",
    "gate": "node scripts/gate/main.ts",
    "lint": "bun run effect:source:check && bun run check && ultracite check && turbo run lint --filter=cas",
    "prepare": "effect-tsgo patch --tsrs --no-typescript",
    "proof": "node scripts/proof/main.ts",
    "security:audit": "bash scripts/osv apps/cas/uv.lock",
    "seo:audit": "bunx squirrelscan@latest audit https://nakafa.com --level surface --format llm",
    "start": "turbo run start",
    "test": "bun run check && bun run test:scripts && turbo run test",
    "test:scripts": "bun run typecheck:scripts && vitest run --config scripts/vitest.config.mts",
    "test:ui": "turbo run test:ui",
    "test:watch": "turbo run test:watch",
    "typecheck:scripts": "tsrs --project scripts/tsconfig.json --noEmit",
    "version-packages": "changeset version"
  },
  "overrides": {
    "@effect/ai-openai-compat": "4.1.5",
    "@effect/ai-openrouter": "4.1.5",
    "@effect/platform-node": "4.1.5",
    "@effect/platform-node-shared": "4.1.5",
    "capnp-es": "0.0.17",
    "convex-helpers": "0.1.136",
    "glob": "14.0.3",
    "micromark-extension-math@3.1.0>katex": "0.19.1",
    "minimatch": "11.0.3",
    "prosemirror-model": "1.25.13",
    "prosemirror-transform": "1.12.7",
    "seroval": "1.8.2",
    "seroval-plugins": "1.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "0.73.2",
    "@effect/vitest": "catalog:",
    "@repo/testing": "workspace:*",
    "@repo/utilities": "workspace:*",
    "@sigstore/bundle": "5.0.1",
    "@types/node": "26.6.6",
    "effect": "catalog:",
    "esbuild": "0.28.2",
    "portless": "0.18.1",
    "sigstore": "5.0.1",
    "tsrs": "catalog:",
    "turbo": "2.11.13",
    "ultracite": "8.3.1",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "core-js",
    "core-js-pure",
    "esbuild",
    "msgpackr-extract",
    "msw",
    "protobufjs",
    "sharp",
    "workerd"
  ],
  "patchedDependencies": {
    "@ui-sdk/core@0.1.0-beta.13": "patches/@ui-sdk%2Fcore@0.1.0-beta.13.patch"
  }
}
