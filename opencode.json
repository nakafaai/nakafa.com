{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "posthog": {
      "type": "remote",
      "url": "https://mcp-eu.posthog.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:POSTHOG_MCP_API_KEY}"
      }
    },
    "convex": {
      "type": "local",
      "command": [
        "pnpm",
        "--dir",
        "packages/backend",
        "exec",
        "convex",
        "mcp",
        "start"
      ]
    },
    "shadcn": {
      "type": "local",
      "command": [
        "pnpm",
        "dlx",
        "shadcn@4.16.1",
        "mcp",
        "--cwd",
        "packages/design-system"
      ]
    }
  }
}
