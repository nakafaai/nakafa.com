{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack"
  ],
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off"
      }
    }
  },
  "overrides": [
    {
      // Proven false positives, one file each. The first six call Playwright's
      // `Locator.innerText()`, a method of the test runner, not a DOM node. The
      // other ten read the rendered text of the page, as a learner sees it, where
      // `textContent` would also read hidden elements and the inline `<script>`
      // payloads: the loader data of a page holds the very text that shown.ts and
      // signout.browser.ts wait to see rendered, and serve.ts waits for a row that
      // `content-visibility` leaves undrawn, which empties only its `innerText`.
      "includes": [
        "apps/www/e2e/nina/activity.browser.ts",
        "apps/www/e2e/reading/controls.browser.ts",
        "apps/www/e2e/chat/share.browser.ts",
        "apps/www/e2e/school/calendar.browser.ts",
        "apps/www/e2e/support/navigation/prefetch.ts",
        "apps/www/e2e/tryout/shell.browser.ts",
        "apps/www/e2e/account/signout.browser.ts",
        "apps/www/e2e/auth/recovery.browser.ts",
        "apps/www/e2e/chat/bubble.browser.ts",
        "apps/www/e2e/chat/prompt.browser.ts",
        "apps/www/e2e/chat/words.browser.ts",
        "apps/www/e2e/school/delete.browser.ts",
        "apps/www/e2e/state/stale.browser.ts",
        "apps/www/e2e/support/consent.ts",
        "apps/www/e2e/support/serve.ts",
        "apps/www/e2e/support/shown.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "useDomNodeTextContent": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/www/src/styles/globals.css",
        "packages/design-system/styles/globals.css"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            // Proven false positives: the two `&::-webkit-scrollbar` rules sit in
            // separate `@utility` blocks, and the two `*` rules in separate cascade
            // layers, so merging either would change which rule wins.
            "noDuplicateSelectors": "off",
            "useBaseline": {
              "level": "error",
              "options": {
                // The app shell's sidebar offset is a registered length so it can
                // slide with the sidebar; an unregistered property cannot animate.
                "allowAtRules": ["property"],
                "allowProperties": [
                  // Long lessons skip the layout of blocks off screen, and the
                  // measured fallback heights keep the scroll position steady.
                  "contain-intrinsic-size",
                  "content-visibility",
                  // The thin themed scrollbar outside WebKit, and a reserved
                  // gutter so a page does not shift when its scrollbar appears.
                  "scrollbar-color",
                  "scrollbar-gutter",
                  "scrollbar-width"
                ]
              }
            }
          }
        }
      }
    },
    {
      // The Vite build compiles these React surfaces with React Compiler.
      // Preserve compiler-managed callbacks and TanStack server function references.
      "includes": ["apps/www/**/*.tsx", "packages/design-system/**/*.tsx"],
      "linter": {
        "rules": {
          "performance": {
            "noJsxPropsBind": "off"
          }
        }
      }
    },
    {
      "includes": [
        "*.{ts,tsx,mts,cts}",
        "apps/**/*.{ts,tsx,mts,cts}",
        "packages/**/*.{ts,tsx,mts,cts}",
        "scripts/**/*.{ts,tsx,mts,cts}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@effect/vitest": {
                    "importNames": ["vi"],
                    "message": "Use the configured global vi for mocks. Import the remaining test APIs from @effect/vitest."
                  },
                  // Convex's auth context changes its value after hydration;
                  // Nakafa keeps Convex auth in a store instead.
                  "convex/react": {
                    "importNames": [
                      "Authenticated",
                      "AuthLoading",
                      "AuthRefreshing",
                      "ConvexProviderWithAuth",
                      "Unauthenticated",
                      "useConvexAuth"
                    ],
                    "message": "These read ConvexProviderWithAuth's context, which changes after hydration. Read Convex auth with useConvexAuth from @/components/providers/convex and the gates from @/components/auth/gate."
                  },
                  "@convex-dev/better-auth/react": "This module needs ConvexProviderWithAuth, whose context changes after hydration. Use ConvexProvider from @/components/providers/convex and the gates from @/components/auth/gate."
                },
                "patterns": [
                  {
                    "group": ["vitest", "vitest/*", "!vitest/config"],
                    "message": "Import test APIs from @effect/vitest. Keep vitest only as the required runner and config package."
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "Use the owning @/, @repo/*, or #scripts/* alias instead."
                  },
                  {
                    "group": [
                      "@/**/*.ts",
                      "@/**/*.tsx",
                      "@/**/*.js",
                      "@/**/*.jsx",
                      "@repo/**/*.ts",
                      "@repo/**/*.tsx",
                      "@repo/**/*.js",
                      "@repo/**/*.jsx",
                      "#scripts/**/*.ts",
                      "#scripts/**/*.js"
                    ],
                    "message": "Use extensionless local aliases."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.{ts,tsx,mts,cts}",
        "**/test/**/*.{ts,tsx,mts,cts}",
        "**/vitest.setup.{ts,mts,cts}"
      ],
      "javascript": {
        "globals": ["vi"]
      }
    },
    {
      // Vitest loads each workspace's entrypoint to reach the shared testing config.
      "includes": ["**/vitest.config.mts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      // Three Fiber uses renderer attributes that the DOM-only rule cannot recognize.
      "includes": [
        "packages/design-system/components/contents/mathematics/function/diagram.tsx",
        "packages/design-system/components/three/**/*.tsx",
        "packages/design-system/components/contents/{biology,chemistry,physics}/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAttribute": {
              "level": "error",
              "options": {
                "ignore": [
                  "args",
                  "attach",
                  "castShadow",
                  "depthWrite",
                  "distance",
                  "emissive",
                  "emissiveIntensity",
                  "frustumCulled",
                  "geometry",
                  "groundColor",
                  "intensity",
                  "map",
                  "material",
                  "metalness",
                  "object",
                  "polygonOffset",
                  "polygonOffsetFactor",
                  "polygonOffsetUnits",
                  "position",
                  "quaternion",
                  "receiveShadow",
                  "renderOrder",
                  "rotation",
                  "roughness",
                  "shadow-bias",
                  "shadow-camera-bottom",
                  "shadow-camera-left",
                  "shadow-camera-right",
                  "shadow-camera-top",
                  "shadow-mapSize-height",
                  "shadow-mapSize-width",
                  "shadow-normalBias",
                  "side",
                  "transparent",
                  "visible",
                  "wireframe"
                ]
              }
            }
          }
        }
      }
    },
    {
      // Confect module filenames preserve deployed function-path contracts.
      "includes": ["packages/backend/confect/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["camelCase", "kebab-case"],
                "requireAscii": true
              }
            }
          }
        }
      }
    },
    {
      // TanStack Router names a splat route `$`, which no case convention accepts.
      "includes": ["apps/www/src/routes/**/$.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "match": "[$].tsx?"
              }
            }
          }
        }
      }
    }
  ],
  "linter": {
    "rules": {
      "correctness": {
        // Proven false positives, 101 in all on 30 October 2026: the rule reads any
        // capitalized key holding a function inside a function as a component. Each
        // key is a name another API sets: 54 are error tags in `Effect.catchTags`,
        // 34 are tags in `Match.tags`, `Match.tagsExhaustive`, `Match.valueTags` and
        // `Match.discriminators`, 9 are the cases of a `Data.TaggedEnum` `match`,
        // 2 are the `GET` and `POST` handlers of a TanStack Start route, and 2 are
        // the `Intl.DateTimeFormat` of a test double of `Intl`. The one component
        // factory it found, the evilcharts brush preview, is now a module-level
        // component. noNestedComponentDefinitions and the policy check
        // (scripts/check/tests.ts) still reject every nested component.
        "noComponentHookFactories": "off"
      },
      "suspicious": {
        "noLeakedRender": "off",
        "noShadow": "off",
        "noUnnecessaryConditions": "off"
      },
      "performance": {
        "noAwaitInLoops": "off"
      },
      "style": {
        "useDestructuring": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**/*",
      "!packages/backend/convex/**/*",
      "!packages/backend/confect/_generated/**/*",
      "!packages/backend/confect/integrations/openapi.json",
      "!packages/backend/components/betterAuth/_generated/**/*",
      "!repos/**/*"
    ]
  }
}
