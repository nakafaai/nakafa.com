{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack"
  ],
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off"
      }
    }
  },
  "overrides": [
    {
      // Playwright assertions read what a learner sees, which `innerText` gives
      // and `textContent` does not: it includes hidden text.
      "includes": ["apps/www/e2e/**"],
      "linter": {
        "rules": {
          "performance": {
            "useDomNodeTextContent": "off"
          }
        }
      }
    },
    {
      // The global styles use progressive enhancements (`content-visibility`,
      // `contain-intrinsic-size`, the scrollbar properties, `@property`) that a
      // browser without them ignores. Tailwind's `@utility` and `@layer` blocks
      // each scope their own selectors, which the duplicate check reads as one.
      "includes": [
        "apps/www/src/styles/globals.css",
        "packages/design-system/styles/globals.css"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noDuplicateSelectors": "off",
            "useBaseline": "off"
          }
        }
      }
    },
    {
      // The Vite build compiles these React surfaces with React Compiler.
      // Preserve compiler-managed callbacks and TanStack server function references.
      "includes": ["apps/www/**/*.tsx", "packages/design-system/**/*.tsx"],
      "linter": {
        "rules": {
          "performance": {
            "noJsxPropsBind": "off"
          }
        }
      }
    },
    {
      "includes": [
        "*.{ts,tsx,mts,cts}",
        "apps/**/*.{ts,tsx,mts,cts}",
        "packages/**/*.{ts,tsx,mts,cts}",
        "scripts/**/*.{ts,tsx,mts,cts}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@effect/vitest": {
                    "importNames": ["vi"],
                    "message": "Use the configured global vi for mocks. Import the remaining test APIs from @effect/vitest."
                  },
                  // Convex's auth context changes its value after hydration;
                  // Nakafa keeps Convex auth in a store instead.
                  "convex/react": {
                    "importNames": [
                      "Authenticated",
                      "AuthLoading",
                      "AuthRefreshing",
                      "ConvexProviderWithAuth",
                      "Unauthenticated",
                      "useConvexAuth"
                    ],
                    "message": "These read ConvexProviderWithAuth's context, which changes after hydration. Read Convex auth with useConvexAuth from @/components/providers/convex and the gates from @/components/auth/gate."
                  },
                  "@convex-dev/better-auth/react": "This module needs ConvexProviderWithAuth, whose context changes after hydration. Use ConvexProvider from @/components/providers/convex and the gates from @/components/auth/gate."
                },
                "patterns": [
                  {
                    "group": ["vitest", "vitest/*", "!vitest/config"],
                    "message": "Import test APIs from @effect/vitest. Keep vitest only as the required runner and config package."
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "Use the owning @/, @repo/*, or #scripts/* alias instead."
                  },
                  {
                    "group": [
                      "@/**/*.ts",
                      "@/**/*.tsx",
                      "@/**/*.js",
                      "@/**/*.jsx",
                      "@repo/**/*.ts",
                      "@repo/**/*.tsx",
                      "@repo/**/*.js",
                      "@repo/**/*.jsx",
                      "#scripts/**/*.ts",
                      "#scripts/**/*.js"
                    ],
                    "message": "Use extensionless local aliases."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.{ts,tsx,mts,cts}",
        "**/test/**/*.{ts,tsx,mts,cts}",
        "**/vitest.setup.{ts,mts,cts}"
      ],
      "javascript": {
        "globals": ["vi"]
      },
      "linter": {
        "rules": {
          "style": {
            // A test double stands in for a class that the code under test
            // constructs, so its methods keep the class shape without state.
            "useThisInClassMethods": "off"
          }
        }
      }
    },
    {
      // Vitest loads each workspace's entrypoint to reach the shared testing config.
      "includes": ["**/vitest.config.mts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      // Three Fiber uses renderer attributes that the DOM-only rule cannot recognize.
      "includes": [
        "packages/design-system/components/contents/mathematics/function/diagram.tsx",
        "packages/design-system/components/three/**/*.tsx",
        "packages/design-system/components/contents/{biology,chemistry,physics}/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAttribute": {
              "level": "error",
              "options": {
                "ignore": [
                  "args",
                  "attach",
                  "castShadow",
                  "depthWrite",
                  "distance",
                  "emissive",
                  "emissiveIntensity",
                  "frustumCulled",
                  "geometry",
                  "groundColor",
                  "intensity",
                  "map",
                  "material",
                  "metalness",
                  "object",
                  "polygonOffset",
                  "polygonOffsetFactor",
                  "polygonOffsetUnits",
                  "position",
                  "quaternion",
                  "receiveShadow",
                  "renderOrder",
                  "rotation",
                  "roughness",
                  "shadow-bias",
                  "shadow-camera-bottom",
                  "shadow-camera-left",
                  "shadow-camera-right",
                  "shadow-camera-top",
                  "shadow-mapSize-height",
                  "shadow-mapSize-width",
                  "shadow-normalBias",
                  "side",
                  "transparent",
                  "visible",
                  "wireframe"
                ]
              }
            }
          }
        }
      }
    },
    {
      // Confect module filenames preserve deployed function-path contracts.
      "includes": ["packages/backend/confect/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["camelCase", "kebab-case"],
                "requireAscii": true
              }
            }
          }
        }
      }
    },
    {
      // TanStack Router names a splat route `$`, which no case convention accepts.
      "includes": ["apps/www/src/routes/**/$.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "match": "[$].tsx?"
              }
            }
          }
        }
      }
    }
  ],
  "linter": {
    "rules": {
      "correctness": {
        // Effect handler records such as `catchTags({ NotFound: ... })` name each
        // handler after its error tag, which this rule reads as a component made
        // inside a function. noNestedComponentDefinitions and the policy check
        // (scripts/check/tests.ts) still reject every nested component.
        "noComponentHookFactories": "off"
      },
      "suspicious": {
        "noLeakedRender": "off",
        "noShadow": "off",
        "noUnnecessaryConditions": "off"
      },
      "performance": {
        "noAwaitInLoops": "off"
      },
      "style": {
        "useDestructuring": "off",
        // `getElementById` takes the ids React's `useId` makes as they are, where a
        // selector would need `CSS.escape` around each one.
        "useDomQuerySelector": "off",
        // The parsers read their groups by position (`match[1]`, `"$1"`, replace
        // callbacks), so naming every group would rewrite each consumer with no
        // change in what any pattern matches.
        "useNamedCaptureGroup": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**/*",
      "!packages/backend/convex/**/*",
      "!packages/backend/confect/_generated/**/*",
      "!packages/backend/confect/integrations/openapi.json",
      "!packages/backend/components/betterAuth/_generated/**/*",
      "!repos/**/*"
    ]
  }
}
