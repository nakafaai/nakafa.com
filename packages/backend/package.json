{
  "name": "@repo/backend",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./*.ts",
    "./convex/_generated/*": "./convex/_generated/*.js",
    "./scripts/content/acceptance/source.json": "./scripts/content/acceptance/source.json"
  },
  "scripts": {
    "acceptance": "node scripts/content/acceptance/main.ts",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "codegen": "confect codegen && node scripts/refs/main.ts && node scripts/reuse/main.ts",
    "confect:dev": "confect dev",
    "deploy": "bun run codegen && convex deploy --typecheck disable",
    "dev": "convex dev --tail-logs --typecheck disable",
    "generate-schema": "JITI_FS_CACHE=false auth generate --config components/betterAuth/cli.config.ts --yes && mv schema.ts components/betterAuth/schema.ts && bunx --no-install --cwd ../.. ultracite fix packages/backend/components/betterAuth/schema.ts",
    "insights": "convex insights",
    "judgment:measure": "bun scripts/judgment/main.ts",
    "load": "BUN_CONFIG_MAX_HTTP_REQUESTS=4096 bun scripts/load/main.ts",
    "nina:gate": "bun scripts/nina/main.ts",
    "setup": "bun run codegen && convex dev --once --typecheck disable",
    "test": "bun run codegen && vitest run",
    "test:debug": "bun run codegen && vitest --inspect-brk --no-file-parallelism",
    "test:watch": "bun run codegen && vitest watch",
    "typecheck": "bun run codegen && tsrs --project tsconfig.json --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@confect/core": "catalog:",
    "@confect/server": "10.5.0",
    "@convex-dev/agent": "catalog:",
    "@convex-dev/aggregate": "^0.3.4",
    "@convex-dev/ai-sdk-provider": "catalog:",
    "@convex-dev/better-auth": "0.12.6",
    "@convex-dev/presence": "0.4.0",
    "@convex-dev/rate-limiter": "0.4.3",
    "@convex-dev/resend": "^0.2.10",
    "@convex-dev/workflow": "^0.4.10",
    "@convex-dev/workpool": "0.4.15",
    "@effect/platform-node": "catalog:",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-naskh-arabic": "5.3.0",
    "@nakafa/aksara-contracts": "6.2.0",
    "@polar-sh/sdk": "^1.0.2",
    "@posthog/convex": "2.1.8",
    "@react-email/render": "catalog:",
    "@repo/analytics": "workspace:*",
    "@repo/contents": "workspace:*",
    "@repo/design-system": "workspace:*",
    "@repo/editor": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/mascot": "workspace:*",
    "@repo/math": "workspace:*",
    "@repo/seo": "workspace:*",
    "@repo/utilities": "workspace:*",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-bold": "3.33.0",
    "@tiptap/extension-code": "3.33.0",
    "@tiptap/extension-italic": "3.33.0",
    "@tiptap/extension-link": "3.33.0",
    "@tiptap/extension-list": "3.33.0",
    "@tiptap/extension-subscript": "3.33.0",
    "@tiptap/extension-superscript": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/extension-underline": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "ai": "catalog:",
    "better-auth": "1.6.34",
    "convex": "catalog:",
    "convex-helpers": "0.1.133",
    "dedent": "^1.7.2",
    "effect": "catalog:",
    "parse-domain": "^8.4.0",
    "prosemirror-model": "1.25.12",
    "prosemirror-transform": "1.12.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "catalog:",
    "remark-mdx": "catalog:",
    "remark-parse": "catalog:",
    "strip-ansi": "^7.2.0",
    "takumi-pdf": "0.19.0",
    "unified": "catalog:",
    "uqr": "0.1.3",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@confect/cli": "10.5.0",
    "@confect/test": "10.5.0",
    "@edge-runtime/vm": "^5.0.0",
    "@effect/vitest": "catalog:",
    "@repo/testing": "workspace:*",
    "@scalar/openapi-parser": "0.29.20",
    "@types/react": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "auth": "1.6.34",
    "convex-test": "0.0.67",
    "tsrs": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
