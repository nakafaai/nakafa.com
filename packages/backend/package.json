{
  "name": "@repo/backend",
  "version": "2.0.1",
  "private": true,
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "customers:verify": "tsx scripts/customers/verify.ts",
    "customers:verify:prod": "tsx scripts/customers/verify.ts --prod",
    "deploy": "convex deploy",
    "dev": "convex dev --tail-logs",
    "generate-schema": "cd convex/betterAuth && AUTH_GOOGLE_ID=schema-generation AUTH_GOOGLE_SECRET=schema-generation auth generate --yes && pnpm --workspace-root exec ultracite fix packages/backend/convex/betterAuth/schema.ts",
    "insights": "convex insights",
    "runtime:ci": "tsx --conditions=import scripts/content-runtime/ci/main.ts",
    "seed": "convex dev --once && convex run init",
    "setup": "convex dev --once",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:once": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "pnpm --workspace-root exec tsc --project packages/backend/tsconfig.json --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@convex-dev/aggregate": "^0.2.2",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/migrations": "0.3.6",
    "@convex-dev/resend": "^0.2.6",
    "@convex-dev/workflow": "^0.4.4",
    "@convex-dev/workpool": "^0.4.9",
    "@effect/platform": "0.97.1",
    "@effect/platform-node": "0.108.1",
    "@nakafa/aksara-contracts": "https://github.com/nakafaai/aksara/releases/download/contracts-v0.11.0/nakafa-aksara-contracts-0.11.0.tgz",
    "@nakafa/aksara-history": "https://github.com/nakafaai/aksara/releases/download/contracts-v0.12.0/nakafa-aksara-contracts-0.12.0.tgz",
    "@polar-sh/sdk": "^0.49.0",
    "@posthog/convex": "2.1.0",
    "@repo/ai": "workspace:*",
    "@repo/contents": "workspace:*",
    "@repo/math": "workspace:*",
    "@repo/utilities": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "ai": "^7.0.58",
    "better-auth": "1.6.26",
    "buffer": "^6.0.3",
    "convex": "^1.43.0",
    "convex-helpers": "^0.1.122",
    "effect": "catalog:",
    "hono": "^4.13.1",
    "nanoid": "^6.0.1",
    "server-only": "0.0.1",
    "strip-ansi": "^7.2.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@repo/testing": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@vitest/coverage-istanbul": "^4.1.10",
    "auth": "~1.6.26",
    "convex-test": "^0.0.55",
    "glob": "^13.0.6",
    "tsx": "^4.23.11",
    "typescript": "6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
