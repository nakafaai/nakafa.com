{
  "name": "@repo/backend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./*.ts",
    "./scripts/content/acceptance/source.json": "./scripts/content/acceptance/source.json"
  },
  "scripts": {
    "acceptance": "node scripts/content/acceptance/main.ts",
    "build": "pnpm typecheck",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "customers:verify": "tsx scripts/customers/verify.ts",
    "customers:verify:prod": "tsx scripts/customers/verify.ts --prod",
    "deploy": "convex deploy",
    "dev": "convex dev --tail-logs",
    "generate-schema": "cd convex/betterAuth && auth generate --yes && pnpm --workspace-root exec ultracite fix packages/backend/convex/betterAuth/schema.ts",
    "insights": "convex insights",
    "seed": "convex dev --once && convex run init",
    "setup": "convex dev --once",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:once": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --project tsconfig.json --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@convex-dev/aggregate": "^0.3.1",
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/rate-limiter": "0.3.2",
    "@convex-dev/resend": "^0.2.8",
    "@convex-dev/workflow": "^0.4.6",
    "@convex-dev/workpool": "^0.4.11",
    "@effect/platform-node": "catalog:",
    "@modelcontextprotocol/server": "2.0.0",
    "@nakafa/aksara-contracts": "0.37.0",
    "@polar-sh/sdk": "^0.49.0",
    "@posthog/convex": "2.1.4",
    "@repo/ai": "workspace:*",
    "@repo/analytics": "workspace:*",
    "@repo/contents": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/math": "workspace:*",
    "@repo/utilities": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/config": "^0.7.0",
    "ai": "7.0.93",
    "better-auth": "1.6.30",
    "buffer": "^6.0.3",
    "convex": "1.45.0",
    "convex-helpers": "0.1.124",
    "effect": "catalog:",
    "hono": "^4.13.7",
    "nanoid": "^6.0.1",
    "server-only": "0.0.1",
    "strip-ansi": "^7.2.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@effect/vitest": "catalog:",
    "@repo/testing": "workspace:*",
    "@scalar/openapi-parser": "0.29.0",
    "@vitest/coverage-istanbul": "catalog:",
    "auth": "1.6.30",
    "convex-test": "^0.0.56",
    "tsx": "^4.23.13",
    "typescript": "npm:typescript@7.0.2",
    "vite": "^8.2.2",
    "vitest": "catalog:"
  }
}
