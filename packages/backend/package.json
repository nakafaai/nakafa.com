{
  "name": "@repo/backend",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./*.ts",
    "./convex/_generated/*": "./convex/_generated/*.js",
    "./scripts/content/acceptance/source.json": "./scripts/content/acceptance/source.json"
  },
  "scripts": {
    "acceptance": "node scripts/content/acceptance/main.ts",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "codegen": "confect codegen && node scripts/refs/main.ts",
    "confect:dev": "confect dev",
    "customers:verify": "tsx scripts/customers/verify.ts",
    "customers:verify:prod": "tsx scripts/customers/verify.ts --prod",
    "deploy": "pnpm codegen && convex deploy",
    "dev": "convex dev --tail-logs",
    "generate-schema": "cd components/betterAuth && auth generate --config cli.config.ts --yes && pnpm --workspace-root exec ultracite fix packages/backend/components/betterAuth/schema.ts",
    "insights": "convex insights",
    "setup": "pnpm codegen && convex dev --once",
    "test": "pnpm codegen && vitest run",
    "test:coverage": "pnpm codegen && vitest run --coverage",
    "test:debug": "pnpm codegen && vitest --inspect-brk --no-file-parallelism",
    "test:watch": "pnpm codegen && vitest watch",
    "typecheck": "pnpm codegen && tsc --project tsconfig.json --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@confect/core": "10.1.0",
    "@confect/server": "10.1.0",
    "@convex-dev/agent": "0.7.7",
    "@convex-dev/aggregate": "^0.3.1",
    "@convex-dev/ai-sdk-provider": "catalog:",
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/rate-limiter": "0.4.1",
    "@convex-dev/resend": "^0.2.8",
    "@convex-dev/workflow": "^0.4.9",
    "@convex-dev/workpool": "^0.4.13",
    "@effect/platform-browser": "catalog:",
    "@effect/platform-node": "catalog:",
    "@mendable/firecrawl-js": "^4.46.0",
    "@nakafa/aksara-contracts": "0.48.0",
    "@polar-sh/sdk": "^1.0.2",
    "@posthog/convex": "2.1.5",
    "@react-email/render": "2.1.0",
    "@repo/analytics": "workspace:*",
    "@repo/contents": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/math": "workspace:*",
    "@repo/utilities": "workspace:*",
    "@vercel/config": "^0.12.0",
    "ai": "catalog:",
    "better-auth": "1.6.33",
    "buffer": "^6.0.3",
    "convex": "1.46.0",
    "convex-helpers": "0.1.128",
    "dedent": "^1.7.2",
    "effect": "catalog:",
    "gpt-tokenizer": "^4.0.0",
    "parse-domain": "^8.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "6.11.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "server-only": "0.0.1",
    "strip-ansi": "^7.2.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@confect/cli": "10.1.0",
    "@confect/test": "10.1.0",
    "@edge-runtime/vm": "^5.0.0",
    "@effect/vitest": "catalog:",
    "@repo/testing": "workspace:*",
    "@scalar/openapi-parser": "0.29.12",
    "@vitest/coverage-istanbul": "catalog:",
    "auth": "1.6.33",
    "convex-test": "^0.0.60",
    "tsx": "^4.23.15",
    "typescript": "npm:typescript@7.0.2",
    "vite": "^8.3.4",
    "vitest": "catalog:"
  }
}
