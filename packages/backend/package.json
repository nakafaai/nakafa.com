{
  "name": "@repo/backend",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./*.ts",
    "./convex/_generated/*": "./convex/_generated/*.js",
    "./scripts/content/acceptance/source.json": "./scripts/content/acceptance/source.json"
  },
  "scripts": {
    "acceptance": "node scripts/content/acceptance/main.ts",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "codegen": "confect codegen && node scripts/refs/main.ts",
    "confect:dev": "confect dev",
    "deploy": "bun run codegen && convex deploy",
    "dev": "convex dev --tail-logs",
    "generate-schema": "JITI_FS_CACHE=false auth generate --config components/betterAuth/cli.config.ts --yes && mv schema.ts components/betterAuth/schema.ts && bunx --no-install --cwd ../.. ultracite fix packages/backend/components/betterAuth/schema.ts",
    "insights": "convex insights",
    "judgment:measure": "bun scripts/judgment/main.ts",
    "knowledge:compare": "bun scripts/knowledge/main.ts",
    "nina:gate": "bun scripts/nina/main.ts",
    "setup": "bun run codegen && convex dev --once",
    "test": "bun run codegen && vitest run",
    "test:debug": "bun run codegen && vitest --inspect-brk --no-file-parallelism",
    "test:watch": "bun run codegen && vitest watch",
    "typecheck": "bun run codegen && tsc --project tsconfig.json --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@confect/core": "catalog:",
    "@confect/server": "10.4.1",
    "@convex-dev/agent": "catalog:",
    "@convex-dev/aggregate": "^0.3.4",
    "@convex-dev/ai-sdk-provider": "catalog:",
    "@convex-dev/better-auth": "0.12.6",
    "@convex-dev/presence": "0.4.0",
    "@convex-dev/rate-limiter": "0.4.2",
    "@convex-dev/resend": "^0.2.10",
    "@convex-dev/workflow": "^0.4.10",
    "@convex-dev/workpool": "0.4.15",
    "@effect/platform-browser": "catalog:",
    "@effect/platform-node": "catalog:",
    "@nakafa/aksara-contracts": "1.0.0",
    "@polar-sh/sdk": "^1.0.2",
    "@posthog/convex": "2.1.8",
    "@react-email/render": "catalog:",
    "@repo/analytics": "workspace:*",
    "@repo/contents": "workspace:*",
    "@repo/editor": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/mascot": "workspace:*",
    "@repo/math": "workspace:*",
    "@repo/seo": "workspace:*",
    "@repo/utilities": "workspace:*",
    "@tiptap/core": "3.32.1",
    "@tiptap/extension-bold": "3.32.1",
    "@tiptap/extension-code": "3.32.1",
    "@tiptap/extension-italic": "3.32.1",
    "@tiptap/extension-link": "3.32.1",
    "@tiptap/extension-list": "3.32.1",
    "@tiptap/extension-subscript": "3.32.1",
    "@tiptap/extension-superscript": "3.32.1",
    "@tiptap/extension-table": "3.32.1",
    "@tiptap/extension-underline": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "ai": "catalog:",
    "better-auth": "1.6.33",
    "convex": "1.48.0",
    "convex-helpers": "0.1.129",
    "dedent": "^1.7.2",
    "effect": "catalog:",
    "jspdf": "4.2.1",
    "parse-domain": "^8.4.0",
    "prosemirror-model": "1.25.12",
    "prosemirror-transform": "1.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "catalog:",
    "remark-mdx": "catalog:",
    "remark-parse": "catalog:",
    "strip-ansi": "^7.2.0",
    "unified": "catalog:",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@confect/cli": "10.4.1",
    "@confect/test": "10.4.1",
    "@edge-runtime/vm": "^5.0.0",
    "@effect/vitest": "catalog:",
    "@repo/testing": "workspace:*",
    "@scalar/openapi-parser": "0.29.18",
    "@vitest/coverage-istanbul": "catalog:",
    "auth": "1.6.33",
    "convex-test": "^0.0.62",
    "typescript": "npm:typescript@7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
