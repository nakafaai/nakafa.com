{
  "extends": "../typescript-config/library.json",
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsx",
    "target": "ESNext",
    "lib": ["ES2022", "dom", "ESNext.Array", "DOM.Iterable"],
    "allowSyntheticDefaultImports": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./*"],
      "@repo/*": ["../../packages/*"]
    }
  },
  "include": ["./**/*"],
  "exclude": ["./convex/_generated", "./coverage"]
}
